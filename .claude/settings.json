{
  "permissions": {
    "allow": [
      "Bash(cargo test)",
      "Bash(cargo test *)",
      "Bash(cargo clippy)",
      "Bash(cargo clippy *)",
      "Bash(cargo check)",
      "Bash(cargo check *)",
      "Bash(cargo build)",
      "Bash(cargo build *)",
      "Bash(cargo fmt --check)",
      "Bash(./scripts/check.sh)",
      "Bash(./scripts/check.sh *)",
      "Bash(scripts/check.sh)",
      "Bash(scripts/check.sh *)",
      "Bash(./target/debug/scarp list *)",
      "Bash(./target/debug/scarp show *)",
      "Bash(./target/debug/scarp --help)",
      "Bash(./target/debug/scarp --version)"
    ]
  },
  "hooks": {
  "SessionStart": [
    {
      "matcher": "startup|resume",
      "hooks": [
        { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/session-start.sh" }
      ]
    }
  ]
  }
}
